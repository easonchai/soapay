  {
   "type": "text",
   "id": "s1_ev_t",
   "x": 580,
   "y": 458,
   "width": 800,
   "height": 85,
   "text": "alice.soapay.eth                 # ENSv2 subname on Sepolia, its own PermissionedResolver\nstealth = st:eth:0x02…           # the meta-address every payer derives from\naddr    = (none)                 # nothing static to pay by mistake\nROLE_SET_TEXT(stealth) → employee key only   ROLE_REGISTRAR → issuer   ROLE_UNREGISTER → company\nnon-transferable · never expires · the same meta-address sits in ERC-6538 on Base",
   "originalText": "alice.soapay.eth                 # ENSv2 subname on Sepolia, its own PermissionedResolver\nstealth = st:eth:0x02…           # the meta-address every payer derives from\naddr    = (none)                 # nothing static to pay by mistake\nROLE_SET_TEXT(stealth) → employee key only   ROLE_REGISTRAR → issuer   ROLE_UNREGISTER → company\nnon-transferable · never expires · the same meta-address sits in ERC-6538 on Base",
