# Copy to contracts/.env (git-ignored). Never commit real keys.
# Deployer of StealthDisperse on Base Sepolia; scripts/fund-usdc.sh tops up this address by default.
DEPLOYER_PRIVATE_KEY=
# Owner of the soapay.eth parent on Sepolia (ENSv2 issuer setup).
PARENT_OWNER_PRIVATE_KEY=
ISSUER_ADDRESS=
# Optional: Circle testnet API key (TEST_API_KEY:…) for scripts/fund-usdc.sh. Circle's API faucet needs a
# Circle account that completed verification; empty = the script prints the manual faucet.circle.com link.
CIRCLE_API_KEY=
