# --- Required ---------------------------------------------------------------
# Base (8453) or Base Sepolia (84532) JSON-RPC. The public sepolia.base.org caps
# eth_getLogs at 1,000 blocks; backfilling from the Announcer start block is far
# faster on a provider that allows 10k+ block ranges.
RPC_URL=https://sepolia.base.org

# --- Chain / server ---------------------------------------------------------
CHAIN_ID=84532
PORT=8787
DB_PATH=./data/soapay.db
# Comma-separated SPA origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set true behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false
BODY_LIMIT_BYTES=16384
# Parent name; ENSv2 subnames are issued under it.
PARENT_NAME=soapay.eth
# Ethereum Sepolia RPC: the ENSv2 issuer and the rotation gas top-up.
L1_RPC_URL=

# --- ENSv2 name issuer (contracts/ENSV2.md) -----------------------------------
# With ISSUER_PRIVATE_KEY and L1_RPC_URL set, POST /names issues <label>.soapay.eth on
# ENSv2 Sepolia; otherwise names are stored only (a startup warning says so).
# The key needs only ROLE_REGISTRAR on the parent's subname registry. It never writes the
# `stealth` record: the registrant does (option A, docs/mvp-spec.md §2.1).
ISSUER_PRIVATE_KEY=
# Printed by `pnpm --filter @soapay/contracts ensv2:setup-parent` (contracts/ENSV2.md, step 2).
# Optional: looked up on-chain when empty.
ENS_SUBNAME_REGISTRY=
ENS_RESOLVER_ADMIN=

# --- Registration relayer (POST /register is 503 without it) ----------------
# Funded with Base Sepolia ETH. Never commit a real key.
RELAYER_PRIVATE_KEY=
RECEIPT_TIMEOUT_MS=60000

# --- World ID 4.0 (docs/worldid.md) ------------------------------------------
# One trust moment: key rotation. A name may carry a Selfie Check session; a rotation
# must prove it. No enrollment gate. Public values (not secrets):
WORLD_APP_ID=app_0cc7167efe114ac2e0ef7d9827098353
WORLD_RP_ID=rp_3ede5fe1cab9af48
# staging = the World ID simulator (demo default); production = World App;
# sandbox = the Selfie Check sandbox app.
WORLD_ENV=staging
# RP signing key from the Developer Portal (World ID 4.0 → signer). Server-only; required
# unless WORLD_ID_DISABLED=true. Keep it in your local .env, never in git or chat.
WORLD_RP_SIGNING_KEY=
# true: no sessions and no rotation attestations (every meta change needs the employer).
WORLD_ID_DISABLED=false
# Lifetime of a signed RP context, seconds.
WORLD_RP_TTL_SECONDS=300
# A session attached after enrollment (POST /names/:label/session) can back a rotation
# only after this delay, so a stolen registrant key can't attach-then-rotate at once.
WORLD_ATTACH_COOLDOWN_SECONDS=259200
RATE_LIMIT_RP_CONTEXT_PER_IP=60

# --- Rotation attestations and gas top-up (docs/mvp-spec.md §2.1) -------------
# Signs MetaRotation attestations; sender apps pin its address as VITE_ATTESTER.
# Rotation returns 503 without it.
ATTESTER_PRIVATE_KEY=
# Ethereum Sepolia key that tops up a registrant's gas for its own setText. Optional.
L1_RELAYER_PRIVATE_KEY=
TOPUP_GAS=150000
# Hard cap per top-up, in wei (0.002 ETH).
TOPUP_CAP_WEI=2000000000000000
TOPUP_PER_REGISTRANT_PER_DAY=3
TOPUP_PER_DAY=100

# --- Uniswap Trading API proxy (POST /uniswap/{quote,swap,check_approval}) ---
# Server-only key from the Uniswap developer portal. Empty: the proxy answers
# 503 uniswap_disabled and the SDK falls back to the Universal Router.
UNISWAP_API_KEY=
RATE_LIMIT_UNISWAP_PER_IP_PER_MINUTE=30
UNISWAP_BODY_LIMIT_BYTES=8192

# --- Rate limits (fixed window) ---------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_REGISTER_PER_IP=3
RATE_LIMIT_REGISTER_PER_REGISTRANT=3
# Also applies to POST /names/:label/session and /rotation.
RATE_LIMIT_NAMES_PER_IP=10
# POST /invites (employer invite links, docs/mvp-spec.md §7). The per-employer limit counts
# only invites with a valid signature. Invite links are built by the sender app from its
# VITE_RECIPIENT_URL, so the API needs no RECIPIENT_URL.
RATE_LIMIT_INVITES_PER_EMPLOYER=50
RATE_LIMIT_INVITES_PER_IP=20

# --- Announcement indexer ---------------------------------------------------
INDEXER_ENABLED=true
# Defaults to the canonical Announcer start block for CHAIN_ID.
INDEXER_START_BLOCK=
# Initial/max getLogs range; halved automatically on provider range errors.
INDEXER_CHUNK_SIZE=1000
INDEXER_POLL_MS=4000
# Blocks behind the head re-scanned every poll (reorg safety).
INDEXER_REORG_DEPTH=10
