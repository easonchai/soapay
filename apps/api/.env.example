# --- Required ---------------------------------------------------------------
# Base (8453) or Base Sepolia (84532) JSON-RPC. The public sepolia.base.org caps
# eth_getLogs at 1,000 blocks; backfilling from the Announcer start block is far
# faster on a provider that allows 10k+ block ranges.
RPC_URL=https://sepolia.base.org

# --- Chain / server ---------------------------------------------------------
CHAIN_ID=84532
PORT=8787
DB_PATH=./data/soapay.db
# Comma-separated SPA origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set true behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false
BODY_LIMIT_BYTES=16384
# Parent for display in /names responses (ENSv2 subnames live under it).
PARENT_NAME=soapay.eth
# Ethereum Sepolia RPC for the ENSv2 NameIssuer (unused by the default no-op issuer).
L1_RPC_URL=

# --- Registration relayer (POST /register is 503 without it) ----------------
# Funded with Base Sepolia ETH. Never commit a real key.
RELAYER_PRIVATE_KEY=
RECEIPT_TIMEOUT_MS=60000

# --- Rate limits (fixed window) ---------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_REGISTER_PER_IP=3
RATE_LIMIT_REGISTER_PER_REGISTRANT=3
RATE_LIMIT_NAMES_PER_IP=10

# --- Announcement indexer ---------------------------------------------------
INDEXER_ENABLED=true
# Defaults to the canonical Announcer start block for CHAIN_ID.
INDEXER_START_BLOCK=
# Initial/max getLogs range; halved automatically on provider range errors.
INDEXER_CHUNK_SIZE=1000
INDEXER_POLL_MS=4000
# Blocks behind the head re-scanned every poll (reorg safety).
INDEXER_REORG_DEPTH=10
