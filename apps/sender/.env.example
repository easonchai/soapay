# Soapay sender app. Every value is optional. The Settings screen can override
# the chain, StealthDisperse address and RPC URLs per browser (localStorage).

# 84532 = Base Sepolia (default), 8453 = Base.
VITE_CHAIN_ID=84532

# StealthDisperse on the chain above. Leave it empty while the contract is not
# deployed: then only the EIP-5792 smart-account path and the Safe export can pay.
VITE_STEALTH_DISPERSE=

# RPC for the pay chain. Empty = the chain's public default RPC.
VITE_RPC_URL=

# RPC for the ENS chain (Sepolia for Base Sepolia, Ethereum mainnet for Base).
VITE_ENS_RPC_URL=

# apps/api base URL. The app reads GET /names/:label/attestations when a pinned
# meta-address changes (docs/mvp-spec.md §2.1).
VITE_API_URL=http://localhost:8787

# The Soapay attester address (the API's ATTESTER_PRIVATE_KEY, also shown by
# GET /worldid/config). PINNED here: a key rotation is auto-accepted only when its
# MetaRotation attestation is signed by exactly this address. Empty = every rotation
# needs manual employer approval.
VITE_ATTESTER=

# Recipient app base URL, used to build invite links
# (<VITE_RECIPIENT_URL>/#/join?code=...&label=...&org=..., docs/mvp-spec.md section 7).
VITE_RECIPIENT_URL=http://localhost:5173

# Optional: enables the WalletConnect connector. Also run
# `pnpm --filter @soapay/sender add @walletconnect/ethereum-provider` (not bundled by default).
VITE_WALLETCONNECT_PROJECT_ID=

# Dev only: resolve names to generated demo meta-addresses (no ENS or registry
# reads), serve attestations from a local mock attester (pinned instead of
# VITE_ATTESTER), and offer a demo wallet. Ignored in production builds.
VITE_MOCK_ENS=0

# Recipient app URL for the "Receive" link. Empty = VITE_RECIPIENT_URL.
VITE_OTHER_APP_URL=
# CK alias accepted (ours wins when both are set): VITE_STEALTH_DISPERSE_ADDRESS (= VITE_STEALTH_DISPERSE).
