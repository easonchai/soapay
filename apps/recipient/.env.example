# Soapay recipient app. Every value can be overridden in Settings (stored in the encrypted vault).

# Soapay API (registration relayer, names, announcement index).
VITE_API_URL=http://localhost:8787
# 84532 = Base Sepolia (default), 8453 = Base.
VITE_CHAIN_ID=84532
# ERC-4337 bundler for spends (Pimlico or similar). Optional: users can enter one in Settings.
VITE_BUNDLER_URL=
# Comma-separated StealthDisperse deployments. Only for these callers is the metadata payer trusted.
VITE_STEALTH_DISPERSE=
# JSON-RPC for balances and the getLogs fallback. Empty = the chain's public RPC.
VITE_RPC_URL=
# 1 = in-browser mock API, chain and bundler with demo payments (no network needed).
VITE_MOCK_API=0
# Ethereum Sepolia RPC for the ENSv2 `stealth` record write when rotating keys. Empty = public RPC.
VITE_L1_RPC_URL=
# Convert quotes go through the Soapay API's Uniswap proxy (${VITE_API_URL}/uniswap), which injects
# UNISWAP_API_KEY server-side. Never put the key here. 0 = use the Universal Router fallback instead.
VITE_SWAP_VIA_API=1
