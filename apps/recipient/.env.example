# Soapay recipient app. Every value can be overridden in Settings (stored in the encrypted vault).

# Soapay API (registration relayer, names, announcement index).
VITE_API_URL=http://localhost:8787
# 84532 = Base Sepolia (default), 8453 = Base.
VITE_CHAIN_ID=84532
# ERC-4337 bundler for spends (e.g. the keyless https://public.pimlico.io/v2/84532/rpc). Optional: users can
# enter one in Settings. Never put a keyed URL here: it ships in the bundle.
VITE_BUNDLER_URL=
# Comma-separated StealthDisperse deployments. Only for these callers is the metadata payer trusted.
VITE_STEALTH_DISPERSE=
# JSON-RPC for balances and the getLogs fallback. Empty = the chain's public RPC.
VITE_RPC_URL=
# 1 = in-browser mock API, chain and bundler with demo payments (no network needed).
VITE_MOCK_API=0
# Ethereum Sepolia RPC for the ENSv2 `stealth` record write when rotating keys. Empty = public RPC.
VITE_L1_RPC_URL=
# Base Sepolia only (D-52): the pay token. Empty = Soapay's mock USDC (the SDK default). Base mainnet
# always uses Circle USDC. On Base Sepolia spends are gas-sponsored through ${VITE_API_URL}/paymaster
# (the API holds the Pimlico key), and Exit is hidden (the mock token can't bridge).
VITE_PAY_TOKEN=
# Sender app URL for the "Pay" tab. Empty = http://localhost:5174 in dev, / in a build.
VITE_OTHER_APP_URL=
# CK's names are accepted as aliases (ours win when both are set):
# VITE_STEALTH_DISPERSE_ADDRESS (= VITE_STEALTH_DISPERSE), VITE_RELAY_URL (its origin = VITE_API_URL).
