# Soapay MCP server (apps/mcp). Pass these as env to `claude mcp add` or your MCP client.
# Keys are read from env only and never returned by any tool or written to logs.

# Soapay API (registration relayer, name issuer, announcement index, Uniswap proxy)
API_URL=http://localhost:8787
CHAIN_ID=84532
# Base Sepolia RPC (payer txs, balances, ERC-6538 registry)
RPC_URL=https://sepolia.base.org
# Ethereum Sepolia RPC (ENSv2 names)
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ERC-4337 bundler for spends (7702); the public Pimlico endpoint is keyless
BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc
# Base Sepolia (D-52): spends' gas is sponsored through the Soapay API's ERC-7677 proxy (it holds the
# Pimlico key). Empty = ${API_URL}/paymaster. Base mainnet uses the Circle paymaster (gas in USDC).
PAYMASTER_URL=
# Base Sepolia only: the pay token. Empty = Soapay's mock USDC. Base mainnet is always Circle USDC.
PAY_TOKEN=
STEALTH_DISPERSE=0x6B7a1cC570Af2DDd427DA694351438F0FE8039CA

# The agent as RECIPIENT: BIP-39 mnemonic -> spending, viewing and registrant keys
AGENT_MNEMONIC=
# The agent as PAYER: an EOA holding USDC and a little ETH on Base Sepolia (the get_test_funds tool
# drops test USDC to it once)
AGENT_PAYER_PRIVATE_KEY=

# Local state: daily cap counter, pinned meta-addresses, consolidation-guard graph (no keys)
STATE_DIR=~/.soapay-mcp

# Guardrails
MAX_PER_CALL_USDC=5
MAX_PER_DAY_USDC=20
# Optional: comma-separated names; when set, only these names can be paid (and no raw addresses)
PAYEE_ALLOWLIST=
# Optional: payers whose announcements count as known in `scan`
KNOWN_PAYERS=
# Optional: addresses the guard treats as identifiable (the payer address always is)
IDENTIFIABLE_ADDRESSES=
